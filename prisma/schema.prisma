// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
  // No binaryTargets needed — upgraded to Prisma v7 2026-08-17, which
  // replaced the native Rust query engine with a WASM query compiler
  // (platform-independent by construction). This is what actually fixed
  // the "could not locate the Query Engine for runtime rhel-openssl-3.0.x"
  // error on Vercel — binaryTargets + outputFileTracingIncludes workarounds
  // were tried first on v6 and didn't work (Next.js's file-tracing doesn't
  // reliably include natively-loaded binaries from a custom generator output
  // path). See CLAUDE.md gotchas for the full troubleshooting trail.
}

// Prisma v7: connection URLs no longer live here — `url`/`directUrl` moved to
// prisma.config.ts (for Migrate/CLI) and the `adapter` passed to PrismaClient
// (for the app at runtime, see lib/prisma.ts). This block is now just the
// provider declaration.
datasource db {
  provider = "postgresql"
}

model Profile {
  id        Int      @id @default(autoincrement())
  name      String
  rank      Int
  createdAt DateTime
  updatedAt DateTime @default(now()) @updatedAt
}

// Singleton (always id=1) — backs the site-wide ProfileBanner (name/alias/
// avatar/bio/socials), editable from the admin "Logistics" section. Not
// game-specific — that's what the per-game Profile/games.ts info is for.
model SiteProfile {
  id             Int      @id @default(1)
  displayName    String   @default("ITAMI")
  alias          String   @default("NONAME")
  avatarUrl      String   @default("/pfp.png")
  bio            String   @default("")
  instagramLabel String   @default("")
  instagramUrl   String   @default("")
  discordLabel   String   @default("")
  discordUrl     String   @default("")
  updatedAt      DateTime @default(now()) @updatedAt
}

// Manual display order for the top-level game/anime entries (Sekai/Genshin/
// Anime) — the sidebar icon rail, the profile's folder tabs, and the
// admin's own entry switcher all follow this. One row per games.ts slug;
// edited from the admin "Logistics" section. No row for a slug = falls
// back to games.ts's own array order for that entry.
model EntryOrder {
  slug  String @id
  order Int
}

model Card {
  id              Int        @id
  name            String
  rarity          Int
  characterId     Int
  userCards       UserCard[]
  assetbundleName String
  character       Character  @relation(fields: [characterId], references: [id])
}

model UserCard {
  id              Int     @id @default(autoincrement())
  cardId          Int     @unique
  card            Card    @relation(fields: [cardId], references: [id])
  level           Int
  masterRank      Int
  skillLevel      Int
  specialTraining Boolean
}

model Character {
  id              Int                  @id
  firstName       String?
  givenName       String
  unit            String
  cards           Card[]
  userCharacters  UserCharacter[]
  challengeStages UserChallengeStage[]
}

model Music {
  id              Int                 @id
  title           String
  assetbundleName String
  isHidden        Boolean             @default(false) // manually excluded from display; kept as a row (not deleted) so /api/seed/musics' skipDuplicates leaves it alone on future reseeds
  results         UserMusicResult[]
  favorites       UserMusicFavorite[]
}

model UserMusicResult {
  id         Int    @id @default(autoincrement())
  musicId    Int
  music      Music  @relation(fields: [musicId], references: [id])
  difficulty String
  playResult String

  @@unique([musicId, difficulty])
}

model UserMusicFavorite {
  id      Int   @id @default(autoincrement())
  musicId Int   @unique
  music   Music @relation(fields: [musicId], references: [id])
}

model UserCharacter {
  id            Int       @id @default(autoincrement())
  characterId   Int       @unique
  character     Character @relation(fields: [characterId], references: [id])
  characterRank Int
  favoriteTier  Int?
}

model Stamp {
  id                  Int         @id
  name                String
  assetbundleName     String
  characterId         Int
  gameCharacterUnitId Int?
  userStamps          UserStamp[]
}

model UserStamp {
  id      Int   @id @default(autoincrement())
  stampId Int   @unique
  stamp   Stamp @relation(fields: [stampId], references: [id])
}

model Event {
  id                 Int         @id
  name               String
  assetbundleName    String
  bgmAssetbundleName String?
  eventType          String
  startAt            DateTime
  userEvents         UserEvent[]
  unit               String?
}

model UserEvent {
  id      Int   @id @default(autoincrement())
  eventId Int   @unique
  event   Event @relation(fields: [eventId], references: [id])
  rank    Int?
}

model Honor {
  id              Int         @id
  name            String
  assetbundleName String
  honorRarity     String
  userHonors      UserHonor[]
  groupId         Int?
}

model UserHonor {
  id      Int   @id @default(autoincrement())
  honorId Int   @unique
  honot   Honor @relation(fields: [honorId], references: [id])
  level   Int
}

model BondHonor {
  id             Int              @id
  name           String
  bondsGroupId   Int
  characterId1   Int
  characterId2   Int
  honorRarity    String
  userBondHonors UserBondHonors[]
}

model UserBondHonors {
  id          Int       @id @default(autoincrement())
  bondHonorId Int
  bondHonor   BondHonor @relation(fields: [bondHonorId], references: [id])
  level       Int
}

model AreaItem {
  id              Int            @id
  name            String
  areaId          Int
  assetbundleName String
  userAreaItems   UserAreaItem[]
}

model UserAreaItem {
  id         Int      @id @default(autoincrement())
  areaItemId Int
  areaItem   AreaItem @relation(fields: [areaItemId], references: [id])
  level      Int
}

model UserChallengeStage {
  id             Int       @id @default(autoincrement())
  characterId    Int
  character      Character @relation(fields: [characterId], references: [id])
  challengeLevel Int
}

model MusicDifficulty {
  id              Int    @id
  musicId         Int
  musicDifficulty String // uppercased to match UserMusicResult ("EASY")
  playLevel       Int
  totalNoteCount  Int

  @@unique([musicId, musicDifficulty])
}

model MusicTag {
  id       Int    @id
  musicId  Int
  musicTag String
  seq      Int

  @@unique([musicId, musicTag])
}

model HonorGroup {
  id        Int     @id
  name      String?
  honorType String?
}

model AdminOtp {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
}

model AdminSession {
  id        String   @id @default(cuid())
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// Genshin data is 100% synced from the HoYoLAB battle-chronicle API (no
// master-data seed like Sekai — we only ever see characters you actually
// own). Equipped weapon is embedded directly on the character; artifacts
// are a separate table since a character has up to 5. Full sync replaces
// this data each run (see app/api/genshin/sync/route.ts).
//
// Singleton (always id=1) holding the live HoYoLAB session cookie, admin-
// editable from GenshinEditor.tsx instead of living in HOYOLAB_COOKIE env —
// on a deployed instance, updating an env var means the Vercel dashboard +
// a redeploy; this lets a fresh cookie be pasted in directly through the
// site's own admin panel (e.g. from a phone) when it periodically expires.
// Deliberately no GraphQL query field exposes hoyolabCookie's value back —
// write-only from the admin UI's perspective, never displayed/logged.
model GenshinConfig {
  id            Int      @id @default(1)
  hoyolabCookie String?
  updatedAt     DateTime @default(now()) @updatedAt
}

model GenshinCharacter {
  id                Int               @id // HoYoLAB avatar_id
  name              String
  element           String
  rarity            Int
  icon              String
  image             String            @default("") // big splash art (HoYoLAB base.image)
  stats             Json              @default("[]") // [{ name, value }] — HoYoLAB's own computed final stats (selected_properties)
  level             Int
  constellation     Int
  friendship        Int
  normalAttackLvl   Int
  elementalSkillLvl Int
  elementalBurstLvl Int
  weaponId          Int
  weaponName        String
  weaponIcon        String
  weaponRarity      Int
  weaponLevel       Int
  weaponRefinement  Int
  isFavorite        Boolean           @default(false) // manual, admin-only — sync never touches this
  costumes          Json              @default("[]") // [{ id, name, icon }] — owned skins (HoYoLAB base.costumes)
  selectedCostumeId Int?              // manual — which costume's art to display; null = default art. Sync never touches this
  artifacts         GenshinArtifact[]
  updatedAt         DateTime          @default(now()) @updatedAt
}

// Full playable roster (owned + unowned), used only to render locked
// characters on the Characters tab. Sourced from Enka Network's static
// character/name data (raw.githubusercontent.com/EnkaNetwork/API-docs) —
// separate from GenshinCharacter, which only ever holds what HoYoLAB sync
// returns (i.e. characters actually owned).
model GenshinCharacterMaster {
  id      Int    @id // matches HoYoLAB avatar_id / GenshinCharacter.id
  name    String
  element String
  rarity  Int
  icon    String
  region  String @default("Other") // nation/story-arc grouping (gi.yatta.moe avatar.region, normalized)
}

model GenshinArtifact {
  id            Int              @id @default(autoincrement())
  characterId   Int
  character     GenshinCharacter @relation(fields: [characterId], references: [id], onDelete: Cascade)
  slot          String // flower / feather / sands / goblet / circlet
  setName       String
  icon          String
  rarity        Int
  level         Int
  mainStatName  String
  mainStatValue String
  substats      Json // [{ name: string, value: string }]
}

// Master data for the two tables below, seeded once from gi.yatta.moe (same
// source/precedent as GenshinCharacterMaster) — not touched by any sync.
// goodKey is resolved at seed time (lib/genshinGoodKeys.ts) by matching a
// normalized name against genshin-optimizer's own authoritative key list —
// null means no exact match was found (newer/event items that source
// hasn't caught up to yet), never a guessed value. GenshinArtifactItem/
// GenshinWeaponItem (the GOOD-import inventory tables) join on this.
model GenshinWeaponMaster {
  id         Int                 @id // gi.yatta.moe weapon id
  name       String
  icon       String
  rarity     Int
  weaponType String // Sword / Claymore / Polearm / Catalyst / Bow
  goodKey    String?             @unique // GOOD-format weapon key crosswalk
  items      GenshinWeaponItem[]
}

model GenshinArtifactSetMaster {
  id        Int                   @id // gi.yatta.moe reliquary-set id
  name      String
  icon      String
  rarity    Int // highest rarity this set drops at
  onePiece  String? // the 4 "Prayers for X" sets only have a single 1pc bonus, not 2pc/4pc
  twoPiece  String?
  fourPiece String?
  goodKey   String?               @unique // GOOD-format setKey crosswalk
  items     GenshinArtifactItem[]
}

// Full artifact/weapon inventory (equipped + benched), imported wholesale
// from a .GOOD export produced by a local OCR scanner (Inventory Kamera /
// Genshin Optimizer's scanner) — see app/api/genshin/import-good/route.ts.
// Deliberately separate from GenshinArtifact/GenshinCharacter.weapon* above,
// which stay HoYoLAB-sync-owned (equipped-only, auto-refreshed); this table
// is the only place benched gear shows up at all, since HoYoLAB's public API
// never exposes it. Replaced wholesale on each import — a GOOD export is a
// full inventory snapshot, not a diff.
model GenshinArtifactItem {
  id          Int                      @id @default(autoincrement())
  setId       Int
  set         GenshinArtifactSetMaster @relation(fields: [setId], references: [id])
  slotKey     String // flower / plume / sands / goblet / circlet (GOOD's slot names)
  level       Int
  rarity      Int
  lock        Boolean
  location    String? // raw GOOD character key if equipped (e.g. "HuTao"), null if benched
  mainStatKey String
  substats    Json // [{ key: string, value: number }]
}

model GenshinWeaponItem {
  id         Int                 @id @default(autoincrement())
  weaponId   Int
  weapon     GenshinWeaponMaster @relation(fields: [weaponId], references: [id])
  level      Int
  ascension  Int
  refinement Int
  lock       Boolean
  location   String? // raw GOOD character key if equipped, null if benched
}

// Synced wholesale from Supercell's official API (via RoyaleAPI's proxy —
// see app/api/clashroyale/sync/route.ts) — no master data, only what the
// player endpoint returns. `cards` there is effectively the full card pool
// (count 0 for ones never found), so this table doubles as both "owned" and
// "browse all" — no separate locked/master table needed, unlike Genshin.
model ClashRoyaleCard {
  id                Int      @id // Supercell card id
  name              String
  iconUrl           String // API-provided (content-hashed URL, can't rebuild from id)
  level             Int
  maxLevel          Int
  starLevel         Int?
  evolutionLevel    Int?
  maxEvolutionLevel Int?
  rarity            String
  count             Int
  elixirCost        Int? // absent for Tower Troops (isSupport)
  isSupport         Boolean  @default(false) // Tower Troop, not a deck card
  updatedAt         DateTime @default(now()) @updatedAt
}

// Singleton (always id=1) — overall account stats shown on the profile's
// Clash Royale page (name/level/trophies), synced alongside the card roster.
// No player pfp — the API's only candidate (currentFavouriteCard, a
// player-chosen card emblem) was tried and dropped as confusing/unwanted.
model ClashRoyalePlayer {
  id           Int      @id @default(1)
  name         String
  expLevel     Int
  trophies     Int
  bestTrophies Int
  wins         Int
  losses       Int
  battleCount  Int
  clanName     String?
  arenaName    String?
  updatedAt    DateTime @default(now()) @updatedAt
}

// Synced wholesale from Supercell's official API (via RoyaleAPI's proxy —
// see app/api/brawlstars/sync/route.ts). Only brawlers the player has
// actually unlocked appear in the API response (unlike CR's full pool), and
// the API returns no icon URL at all — iconUrl is built at render time from
// id (app/profile/brawlStarsImages.ts), not stored, per the project's
// "build from id, don't store URLs" convention.
model BrawlStarsBrawler {
  id              Int      @id // Supercell brawler id
  name            String
  power           Int
  rank            Int
  trophies        Int
  highestTrophies Int
  gadgets         Json     @default("[]") // [{ id, name }]
  starPowers      Json     @default("[]") // [{ id, name }]
  gears           Json     @default("[]") // [{ id, name, level }]
  updatedAt       DateTime @default(now()) @updatedAt
}

// Full playable roster (owned + unowned), used only to render locked
// brawlers on the Brawlers tab — mirrors GenshinCharacterMaster's role.
// Sourced from Supercell's static /v1/brawlers endpoint (synced alongside
// BrawlStarsBrawler in the same sync route), since the player endpoint only
// ever returns brawlers you've actually unlocked.
model BrawlStarsBrawlerMaster {
  id   Int    @id // Supercell brawler id
  name String
}

// Singleton (always id=1) — overall account stats shown on the profile's
// Brawl Stars page (pfp/trophies/level), synced alongside the brawler
// roster. iconId is the player's chosen profile icon id — pfp URL is built
// at render time (app/profile/brawlStarsImages.ts), same as brawler
// portraits, since the API returns no icon URL, only the id.
model BrawlStarsPlayer {
  id              Int      @id @default(1)
  name            String
  expLevel        Int
  trophies        Int
  highestTrophies Int
  victories3v3    Int
  soloVictories   Int
  duoVictories    Int
  clubName        String?
  iconId          Int
  updatedAt       DateTime @default(now()) @updatedAt
}

// Manually added via the admin panel (paste a MAL URL) — Dex never syncs
// from a MyAnimeList account/list, it only pulls public title metadata
// (title/image/synopsis) from Jikan (api.jikan.moe, a free MAL mirror) at
// add-time. Status/type are Darren's own tracking, not MAL's.
model AnimeEntry {
  id        Int      @id // MAL id (mal_id from Jikan)
  title     String
  image     String
  synopsis  String?
  url       String // MAL page link
  mediaType String // "Anime" | "Manga" | "Light Novel"
  status    String // "Watching" | "Caught Up" | "Finished" | "Waitlist"
  isFavorite Boolean @default(false) // manual, admin-only — up to a handful shown on the Summary tab
  isQueued   Boolean @default(false) // manual, admin-only — explicitly curated
  // selection for the Summary tab's "Next in Queue", independent of status.
  // Being "Waitlist" doesn't imply isQueued — admin picks which ones surface.
  queueOrder Int? // manual drag-reorder position within whichever status group
  // the entry currently sits in on the admin board — null falls back to
  // createdAt order.
  parentId  Int? // set when this is a season/part of another entry — MAL
  // gives each season its own id/page, so seasons link to a parent title
  // here while keeping their own independent status
  parent    AnimeEntry?  @relation("Seasons", fields: [parentId], references: [id])
  seasons   AnimeEntry[] @relation("Seasons")
  createdAt DateTime     @default(now())
}
